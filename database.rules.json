{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'Admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "name": { ".write": "auth != null && auth.uid === $uid" },
        "email": { ".write": "auth != null && auth.uid === $uid" },
        "phone": { ".write": "auth != null && auth.uid === $uid" },
        "office": { ".write": "auth != null && auth.uid === $uid" },
        "photo": { ".write": "auth != null && auth.uid === $uid" },
        "lastLogin": { ".write": "auth != null && auth.uid === $uid" }
      }
    },

    "auditLogs": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Disaster Management Officer')",
      "$logId": {
        ".write": "auth != null && !data.exists()"
      }
    },

    "incidents": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "rescueTeams": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
